# ──────────────────────────────────────────────
# Library Management System — Environment Variables Template
# ──────────────────────────────────────────────
# Copy this file to ".env" and fill in your own real values.
# NEVER commit the actual ".env" file — it should stay in .gitignore.

# MySQL root password — used by both the Docker mysql container AND Spring Boot's datasource
LIBRARY_DB_PASSWORD=your_mysql_password_here

# Secret key used to sign JWT tokens (use a long random string, e.g. 256-bit hex)
JWT_SECRET=your_jwt_secret_here

# Give your email Id
MAIL_USERNAME=your-email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate one at: Google Account -> Security -> App Passwords
MAIL_PASSWORD=your_gmail_app_password_here